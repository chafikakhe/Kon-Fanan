# Server only. Never prefix any of these with VITE_. Supabase injects SUPABASE_URL,
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY in hosted Edge Functions.
APP_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://PROJECT_REF.supabase.co/functions/v1/google-oauth-callback
# Base64-encoded 32 random bytes. Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY_VERSION=v1
# Independent random secret for the scheduler, NOT a Supabase publishable key.
INTEGRATION_WORKER_SECRET=
