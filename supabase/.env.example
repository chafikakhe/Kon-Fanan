# Injecter ces valeurs avec supabase secrets set --env-file supabase/.env.local
# Ne jamais utiliser le préfixe VITE_ pour les valeurs de ce fichier.
APP_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/google-oauth-callback
# AES-256-GCM : générer 32 octets aléatoires, encodés en base64.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY_VERSION=v1
# Secret aléatoire indépendant, utilisé uniquement par le planificateur/worker.
INTEGRATION_WORKER_SECRET=
# Runtime Supabase : SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY
# sont fournis automatiquement sur Supabase hébergé. Ne jamais les envoyer à React.
